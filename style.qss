/* ============================================================
   style.qss  –  Net Widget  |  Neon Dark Professional
   ============================================================ */

QMainWindow, QWidget#MainWidget {
    background: transparent;
}

QWidget#ContentArea {
    background: rgba(9, 11, 18, 0.88);
    border: 1px solid rgba(0, 255, 180, 0.12);
    border-radius: 14px;
}

/* ── Title Bar ────────────────────────────────────────────── */
QWidget#TitleBar {
    background: rgba(0, 255, 180, 0.04);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom: 1px solid rgba(0, 255, 180, 0.10);
}

QLabel#AppTitle {
    color: rgba(255, 255, 255, 0.95);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#InterfaceBadge {
    color: #00ffb4;
    font-size: 10px;
    font-weight: 600;
    background: rgba(0, 255, 180, 0.07);
    border: 1px solid rgba(0, 255, 180, 0.20);
    border-radius: 6px;
    padding: 1px 7px;
}

/* ── Mode Buttons ─────────────────────────────────────────── */
QPushButton#ModeBtn {
    background: transparent;
    color: rgba(255, 255, 255, 0.30);
    border: 1px solid transparent;
    border-radius: 0px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 12px;
    letter-spacing: 0.3px;
}
QPushButton#ModeBtn:hover {
    color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.05);
}
QPushButton#ModeBtn[active="true"] {
    color: #00ffb4;
    background: rgba(0, 255, 180, 0.10);
    border: 1px solid rgba(0, 255, 180, 0.20);
}

/* ── Window Controls ──────────────────────────────────────── */
QPushButton#WinBtn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.30);
    font-size: 12px;
    padding: 4px;
}
QPushButton#WinBtn:hover {
    color: rgba(255, 255, 255, 0.85);
}
QPushButton#WinBtn[role="close"]:hover {
    background: rgba(239, 68, 68, 0.20);
    color: rgba(255, 80, 80, 0.90);
}

/* ── Reset Button ─────────────────────────────────────────── */
QPushButton#ResetBtn {
    background: transparent;
    color: rgba(255, 255, 255, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 0px;
    font-size: 11px;
    font-weight: 500;
    padding: 4px 14px;
}
QPushButton#ResetBtn:hover {
    color: rgba(239, 68, 68, 0.85);
    border-color: rgba(239, 68, 68, 0.25);
    background: rgba(239, 68, 68, 0.08);
}

/* ── Scroll ───────────────────────────────────────────────── */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical {
    background: transparent; width: 3px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12); border-radius: 2px; min-height: 16px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── Context Menu ─────────────────────────────────────────── */
QMenu {
    background: rgba(9, 11, 18, 0.97);
    border: 1px solid rgba(0, 255, 180, 0.14);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 12px;
    padding: 4px;
}
QMenu::item { padding: 6px 16px; border-radius: 6px; }
QMenu::item:selected {
    background: rgba(0, 255, 180, 0.10);
    color: #00ffb4;
}
QMenu::separator {
    height: 1px;
    background: rgba(0, 255, 180, 0.08);
    margin: 3px 8px;
}
